{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "workload.summary.cpu_gpu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld CPU threads + GPU"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 个 CPU 线程 + GPU"
          }
        }
      }
    },
    "workload.summary.cpu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld CPU threads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 个 CPU 线程"
