    "cycle.error.threshold_gap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thresholds must be at least 10% apart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下限至少需要相差 10%"
          }
        }
      }
    },
    "battery.health.system.source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from macOS System Information"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 macOS 系统信息读取"
          }
        }
      }
    },
    "workload.safety.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task runs only while discharging and stops automatically when charging begins, the cycle stops, or the temperature becomes too high"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务仅在放电阶段运行；开始充电、停止循环或温度过高时会自动停止"
          }
        }
      }
    },
    "battery.state.on_battery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Battery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池"
          }
        }
      }
    },
    "workload.level.balanced.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use about half of the CPU cores"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用约一半的 CPU 核心"
          }
        }
      }
    },
    "workload.level.gentle.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use about one quarter of the CPU cores"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用约四分之一的 CPU 核心"
