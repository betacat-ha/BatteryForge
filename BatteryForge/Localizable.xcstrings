    "workload.safety.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The task runs only while discharging. Thermal protection pauses it at the configured temperature without stopping the cycle, then resumes it after the temperature drops"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任务仅在放电阶段运行；达到设定温度时高温保护会暂停负载但保持循环，温度降低后自动恢复"
          }
        }
      }
    },
