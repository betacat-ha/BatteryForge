    "about.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A native macOS utility for monitoring battery health and automating controlled charge cycles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款用于监测电池健康状态并自动执行受控充放电循环的原生 macOS 工具。"
          }
        }
      }
    },
